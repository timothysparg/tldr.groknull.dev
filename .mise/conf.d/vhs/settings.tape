# Shared VHS settings for every recording
# --- Typography & Window ---
Set FontSize 22
Set LetterSpacing "-1.8"
Set Width 1200
Set Height 600
Set Padding 60          # Large padding mimics the monitor bezel
Set Margin 20
Set BorderRadius 10     # Slight curve like a monitor corner

# --- Typing Feel ---
Set TypingSpeed 80ms
Set WaitTimeout 15m     # long enough for an off-camera `mise install`
